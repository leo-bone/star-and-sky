# Cloudflare 凭证（二选一，勿提交真实值；.cloudflare.env 已被 .gitignore 忽略）
#
# 方式 1（推荐，细粒度权限）：Bearer API Token
#   去 Cloudflare → My Profile → API Tokens → Create Token
#   权限：Zone → Cache Purge → Edit，Zone 限定 star.uichain.org
# CF_API_TOKEN=your_api_token_here
#
# 方式 2（Global API Key + 邮箱）：
#   Global API Key 在 Cloudflare → My Profile → API Keys 获取
# CF_API_KEY=your_global_api_key_here
# CF_EMAIL=you@example.com
